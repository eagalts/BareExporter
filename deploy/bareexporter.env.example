# BareExporter — пример конфигурации.
# Скопируй в /etc/bareexporter/env (systemd) или ~/bareexporter.env (Docker),
# заполни и выставь права 600: файл содержит пароль.

# --- Обязательные ---

# Адрес BMC со схемой, без слеша на конце
REDFISH_BASE_URL=https://10.0.0.0
# Учётная запись iDRAC (достаточно роли только на чтение)
REDFISH_USER=monitoring
REDFISH_PASSWORD=change-me

# --- Необязательные (указаны значения по умолчанию) ---

# Порт HTTP-сервера с /metrics
PARAM_PORT=9436
# Интервал опроса Redfish, секунды
POLL_INTERVAL=60
# Проверять TLS-сертификат BMC (у iDRAC обычно самоподписанный)
VERIFY_SSL=false
# Сбрасывать буфер stdout после каждой строки лога
PARAM_FLUSH=true