[Unit]
Description=Redfish Prometheus Exporter
After=network-online.target
Wants=network-online.target

[Service]
User=bareexporter
EnvironmentFile=/etc/bareexporter/env
ExecStart=/usr/bin/python3 /opt/bareexporter/exporter.py
Restart=on-abnormal
Type=notify
RestartSec=15s
WatchdogSec=180s

[Install]
WantedBy=multi-user.target